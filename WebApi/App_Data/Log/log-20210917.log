;with cte_pending
as
(
select dm.Patient_Id,CASE WHEN coi.OldPatient_Id is not null and year((select MergeDate from Patient.Demographics where Patient_Id=coi.OldPatient_Id)) <= 2021 
and  month((select MergeDate from Patient.Demographics where Patient_Id=coi.OldPatient_Id)) > 9 THEN
(select PatientLastName+', '+PatientFirstName from Patient.Demographics where Patient_Id=coi.OldPatient_Id)
ELSE (PatientLastName+', '+PatientFirstName + case when PatientMiddleInitial is null or PatientMiddleInitial=' ' then '' else ' ' end
+Isnull(PatientMiddleInitial,'')) END as [PatientName],
convert(varchar(10),dm.dob,101) DOB,AdministrativeSex [Gender],coi.OPhysicianLname+', '+coi.OPhysicianFname [Prescriber],
qd.TextInstruction [Direction],
isnull(eod.GiveCodeText,Textinstruction) GiveCodeText,StartDate,
'' [time]
,cast('09/01/2021' as date) [week],qd.orderstatus POrder_Status
,''  [Administeron],vi.DischargeDate as DCDate,
case when [EndDate] is null and qd.OrderStatus=2 and datediff(dd,0,PQuantity_CreatedDate)<=datediff(dd,0,Enddate)
then 'D/C Date: ' + convert(varchar(10),[PQuantity_CreatedDate],101) else 
case when [EndDate] is not null and (DiscontinueFlag=2 or qd.OrderStatus=1) then 'End Date: ' +convert(varchar(10),[EndDate],101) 
when qd.OrderStatus=2 then 'D/C Date: ' + convert(varchar(10),isnull(Enddate,[PQuantity_CreatedDate]),101) else '' end end 
EndDate
from Patient.Demographics dm
join Patient.VisitInfo vi on dm.Patient_Id=vi.Patient_Id
join Admin.Facility fa on vi.facilityId=fa.facility_Id
left join Admin.Companyconfig ca on fa.company_Id=ca.company_Id
join patient.CommonOrderInfo coi on dm.Patient_Id=coi.Patient_Id
join patient.EncodedOrderDetails eod on coi.POrder_Id=eod.POrder_Id
join patient.QuantityDetails qd on coi.POrder_Id=qd.POrder_Id
left join patient.DrugAdminister da on qd.PQuantity_Id=da.PQuantity_Id
where (datediff(dd,0,StartDate) <= datediff(dd,0,'09/01/2021') or datediff(dd,0,StartDate) <= datediff(dd,0,'09/30/2021'))
--and (qd.PRNFlag=0 or qd.PRNFlag is null) 
and da.DrugAdminister_Id is null and qd.orderstatus=1 and dm.Patient_Id=44
union all 
select Patient_Id, [PatientName], DOB, [Gender], [Prescriber], [Direction], GiveCodeText,StartDate,
'' [time]
,DATEADD(DAY,1, [week])  week, POrder_Status
,''  [Administeron], DCDate,EndDate
from cte_pending
where [week] < '09/30/2021'
)

