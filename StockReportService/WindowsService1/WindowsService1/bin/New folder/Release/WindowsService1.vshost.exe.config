<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.5.1"/>
    </startup>
  <appSettings>
    <add key="Mode" value="Daily"/>
    <!-- <add key ="Mode" value ="Interval"/>-->
    <add key="IntervalMinutes" value="1"/>
    <add key="ScheduledTime" value="12:00"/>
    <add key="FacilityId" value="1"/>
    <add key="FromMailID" value="support@promantra.net"/>
  </appSettings>
  <startup useLegacyV2RuntimeActivationPolicy="true">
  <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.0"/>
  </startup>

  <connectionStrings>    
   <add name="constr" providerName="System.Data.SqlClient" connectionString="Data Source=10.20.6.55;Initial Catalog=EMAR;User ID=sa;Password=ABC123abc"/> 
  </connectionStrings>
</configuration>
