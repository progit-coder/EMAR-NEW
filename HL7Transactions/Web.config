<configuration>
  <system.web>
    <webServices>
      <protocols>
        <add name="HttpGet"/>
        <add name="HttpPost"/>
      </protocols>
    </webServices>
    <compilation debug="true" targetFramework="4.5.2"/>
    <httpRuntime targetFramework="4.5.2" executionTimeout="360000"/>
  </system.web>
  <appSettings>
    <add key="InboundFilePendingPath" value="E:/Promantra/InboundLive/Pending/"/>
    <add key="InboundFileCompletedPath" value="E:/Promantra/InboundLive/Completed/"/>
    <add key="InboundFileErrorPath" value="E:/Promantra/InboundLive/Error/"/>
    <add key="OutboundFilePendingPath" value="E:/Promantra/OutboundLive/Pending/"/>
    <add key="OutboundFileCompletedPath" value="E:/Promantra/OutboundLive/Completed/"/>
  </appSettings>
  <connectionStrings>
    <!--<add name="HL7ConnectionString" connectionString="data source=LTCPRO\SQL2012;initial catalog=EMAR;user id=sa;password=ABC123abc;"/>-->
  <add name="HL7ConnectionString" connectionString="data source=LTCPRO\SQL2012;initial catalog=EMAR_Testing;user id=sa;password=ABC123abc;"/>
  </connectionStrings>
  <system.serviceModel>
    <bindings />
    <client />
  </system.serviceModel>
</configuration>